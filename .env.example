# ===================================================
# DIGITAL STORE — Environment Variables Template
# ===================================================
# Copy this file to: backend/.env  (or set as system env vars)
# Fill in all values below with your real credentials.
# NEVER commit the real .env file to Git!
# ===================================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/digital_store
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# --- JWT ---
# Generate a strong random 64-char hex string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# --- CORS Allowed Origins (comma-separated) ---
# [Fix-1] Set your real domain(s) here. Wildcards are NOT allowed.
APP_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# --- Admin Account ---
# [Fix-2] These MUST be set. The app will refuse to start without them.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Admin Notification Email ---
# [Fix-10] Contact form messages will be emailed here
ADMIN_NOTIFICATION_EMAIL=your-admin-notification@yourdomain.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# --- Bakong Payment API ---
BAKONG_API_TOKEN=YOUR_BAKONG_JWT_TOKEN

# --- Resend Email API ---
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# --- Gmail SMTP ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password

# --- Google Gemini AI (Smart Customer Support Bot) ---
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_API_MODEL=gemini-1.5-flash

# --- Frontend Base URL ---
APP_BASE_URL=http://localhost:5173

# ===================================================
# FRONTEND (.env in frontend/ directory)
# ===================================================
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# VITE_API_URL=/api
# VITE_BAKONG_ACCOUNT_ID=your_bakong_id@bkrt         # [Fix-9] Required!
# VITE_BAKONG_PHONE=your_phone_number                 # [Fix-9] Required!
